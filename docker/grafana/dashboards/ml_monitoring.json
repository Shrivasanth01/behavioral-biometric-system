{
  "title": "ML Model Performance",
  "uid": "ml-monitoring",
  "version": 1,
  "schemaVersion": 38,
  "tags": ["data-science", "ml", "monitoring"],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h"]
  },
  "panels": [
    {
      "title": "Model Status",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "ml_model_accuracy",
          "legendFormat": "Accuracy"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.85 },
              { "color": "green", "value": 0.92 }
            ]
          }
        }
      }
    },
    {
      "title": "Current Fraud Score",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "expr": "avg(ml_fraud_score)",
          "legendFormat": "Avg Fraud Score"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 0.75 }
            ]
          }
        }
      }
    },
    {
      "title": "Prediction Latency (p95)",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "ml_prediction_duration_seconds{quantile=\"0.95\"}",
          "legendFormat": "p95 Latency"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.3 },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      }
    },
    {
      "title": "Predictions per Second",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(ml_predictions_total[5m])",
          "legendFormat": "Pred/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        }
      }
    },
    {
      "title": "Model Retraining Status",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "time() - ml_model_last_trained_timestamp_seconds",
          "legendFormat": "Hours since last train"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "duration(h)",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 24 },
              { "color": "red", "value": 72 }
            ]
          }
        }
      }
    },
    {
      "title": "Batch Queue Size",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 20, "y": 0 },
      "targets": [
        {
          "expr": "ml_batch_queue_size",
          "legendFormat": "Queue Size"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      }
    },
    {
      "title": "Model Accuracy Over Time",
      "type": "graph",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 3 },
      "targets": [
        {
          "expr": "ml_model_accuracy",
          "legendFormat": "Accuracy"
        },
        {
          "expr": "ml_model_precision",
          "legendFormat": "Precision"
        },
        {
          "expr": "ml_model_recall",
          "legendFormat": "Recall"
        },
        {
          "expr": "ml_model_f1_score",
          "legendFormat": "F1 Score"
        }
      ],
      "options": {
        "legend": { "show": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "title": "Feature Distribution",
      "type": "graph",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 3 },
      "targets": [
        {
          "expr": "ml_feature_keystroke_dwell_mean",
          "legendFormat": "Keystroke Dwell Mean"
        },
        {
          "expr": "ml_feature_keystroke_flight_mean",
          "legendFormat": "Keystroke Flight Mean"
        },
        {
          "expr": "ml_feature_mouse_velocity_mean",
          "legendFormat": "Mouse Velocity Mean"
        },
        {
          "expr": "ml_feature_touch_pressure_mean",
          "legendFormat": "Touch Pressure Mean"
        }
      ],
      "options": {
        "legend": { "show": true }
      }
    },
    {
      "title": "Fraud Score Distribution",
      "type": "heatmap",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "expr": "ml_fraud_score"
        }
      ]
    },
    {
      "title": "Prediction Latency Distribution",
      "type": "heatmap",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "expr": "rate(ml_prediction_duration_seconds_bucket[5m])"
        }
      ]
    },
    {
      "title": "Model Confidence Score",
      "type": "graph",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 17 },
      "targets": [
        {
          "expr": "ml_model_confidence",
          "legendFormat": "Confidence"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "title": "Behavioral Biometric Anomalies Detected",
      "type": "graph",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 17 },
      "targets": [
        {
          "expr": "rate(ml_anomalies_detected_total[5m])",
          "legendFormat": "Anomalies/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        }
      }
    },
    {
      "title": "Model Resource Usage (CPU/Memory)",
      "type": "graph",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 17 },
      "targets": [
        {
          "expr": "process_cpu_seconds_total{job=\"ml-service\"}",
          "legendFormat": "CPU"
        },
        {
          "expr": "process_resident_memory_bytes{job=\"ml-service\"}",
          "legendFormat": "Memory"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    }
  ]
}
